{
  "name": "registrando-games",
  "version": "1.4.54",
  "description": "Registrando Games",
  "author": "Registrando Games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.registrandogames",
    "productName": "Registrando Games",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "assets/**",
      "icon.png",
      "index.html",
      "main.js",
      "launchers.js",
      "wallpre.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Registrando Games",
      "uninstallDisplayName": "Registrando Games",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null
  }
}
