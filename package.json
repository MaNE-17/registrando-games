{
  "name": "registrando-games",
  "version": "1.29.1",
  "description": "Registrando Games",
  "author": "Registrando Games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.registrandogames",
    "productName": "Registrando Games",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "assets/**",
      "icon.png",
      "index.html",
      "main.js",
      "launchers.js",
      "steamlib.js",
      "wallpre.js",
      "preload.js",
      "pad.js",
      "bp.js",
      "bp.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Registrando Games",
      "uninstallDisplayName": "Registrando Games",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/@kmamal/sdl/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@kmamal/sdl": "1.0.0-9",
    "sql.js": "^1.13.0"
  }
}
